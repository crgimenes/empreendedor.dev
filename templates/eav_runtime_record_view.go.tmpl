<!doctype html>
<html lang="pt-BR" data-bs-theme="dark">
  <head>
    {{template "head" .}}
  </head>
  <body>
    {{template "navbar" .}}

    <main class="container py-5">
      {{ $base := printf "/eav/workspaces/%s/forms/%s" .Workspace.ReferenceID .Form.Slug }}
      <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
          <li class="breadcrumb-item"><a href="/eav">Workspaces</a></li>
          <li class="breadcrumb-item"><a href="/eav/forms?workspace_id={{.Workspace.ID}}">Formulários</a></li>
          <li class="breadcrumb-item"><a href="{{$base}}/records">Registros</a></li>
          <li class="breadcrumb-item active" aria-current="page">Detalhes do Registro</li>
        </ol>
      </nav>

      {{if .Message}}
      <div class="alert alert-success" role="alert">{{.Message}}</div>
      {{end}}

      <div class="card mb-4">
        <div class="card-header">
          <h1 class="h5 mb-0">Registro #{{.Record.ID}}</h1>
          <p class="text-muted mb-0">Ref: {{.Record.ReferenceID}}</p>
        </div>
        <div class="card-body">
          <dl class="row mb-0">
            <dt class="col-sm-3">Status</dt>
            <dd class="col-sm-9">{{.Record.Status}}</dd>

            <dt class="col-sm-3">Criado em</dt>
            <dd class="col-sm-9">{{.Record.CreatedAt.Format "02/01/2006 15:04"}}</dd>

            <dt class="col-sm-3">Atualizado em</dt>
            <dd class="col-sm-9">{{.Record.UpdatedAt.Format "02/01/2006 15:04"}}</dd>
          </dl>
        </div>
      </div>

      <div class="card">
        <div class="card-header">
          <h2 class="h6 mb-0">Valores</h2>
        </div>
        <div class="card-body">
          {{if .Values}}
          <div class="row g-3">
            {{range .Values}}
            <div class="col-md-6">
              <div class="border rounded p-3 h-100">
                <div class="text-muted small">{{.Field.Label}}</div>
                <div class="fw-semibold">{{.Display}}</div>
              </div>
            </div>
            {{end}}
          </div>
          {{else}}
          <p class="text-muted mb-0">Nenhum valor armazenado.</p>
          {{end}}
        </div>
        <div class="card-footer d-flex gap-2">
          <a href="{{$base}}/records" class="btn btn-outline-secondary">Voltar</a>
          <a href="{{$base}}/records/{{.Record.ReferenceID}}/edit" class="btn btn-primary">Editar</a>
        </div>
      </div>
    </main>

    <footer>
      {{template "footer" .}}
    </footer>
    {{template "scripts" .}}
  </body>
</html>
