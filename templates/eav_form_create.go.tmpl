<!doctype html>
<html lang="pt-BR" data-bs-theme="dark">
  <head>
    {{template "head" .}}
  </head>

  <body>
    {{template "navbar" .}}

    <main class="container py-5">
      <nav aria-label="breadcrumb">
          <ol class="breadcrumb">
              <li class="breadcrumb-item"><a href="/eav">Workspaces</a></li>
              <li class="breadcrumb-item"><a href="/eav/forms?workspace_id={{.WorkspaceID}}">Formulários</a></li>
              <li class="breadcrumb-item active" aria-current="page">Novo Formulário</li>
          </ol>
      </nav>

      <div class="card">
          <div class="card-header">
              <h2 class="h5 mb-0">Criar Novo Formulário</h2>
          </div>
          <div class="card-body">
              <form method="POST" action="/eav/forms/create?workspace_id={{.WorkspaceID}}">
                  <input type="hidden" name="csrf_token" value="{{.Csrf}}">
                  
                  <div class="mb-3">
                      <label for="label" class="form-label">Nome (Label)</label>
                      <input type="text" class="form-control" id="label" name="label" required>
                  </div>

                  <div class="mb-3">
                      <label for="slug" class="form-label">Slug (Identificador único)</label>
                      <input type="text" class="form-control" id="slug" name="slug" required pattern="[a-z0-9-_]+" title="Apenas letras minúsculas, números, hífens e underlines">
                      <div class="form-text">Usado em URLs e referências. Ex: <code>cadastro-cliente</code></div>
                  </div>

                  <button type="submit" class="btn btn-primary">Criar Formulário</button>
                  <a href="/eav/forms?workspace_id={{.WorkspaceID}}" class="btn btn-outline-secondary">Cancelar</a>
              </form>
          </div>
      </div>
    </main>
    
    <footer>
      {{template "footer" .}}
    </footer>
    {{template "scripts" .}}
  </body>
</html>
