<!doctype html>
<html lang="pt-BR" data-bs-theme="dark">
  <head>
    {{template "head" .}}
  </head>

  <body>
    {{template "forum_navbar" .}}

    <main class="container py-4 py-md-5">
      <!-- Breadcrumb -->
      <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
          <li class="breadcrumb-item"><a href="/forum">Fóruns</a></li>
          <li class="breadcrumb-item"><a href="/forum/{{.Forum.ExternalID}}">{{.Forum.Title}}</a></li>
          <li class="breadcrumb-item active">{{.Thread.Title}}</li>
        </ol>
      </nav>

      <!-- Header: title and reply button -->
      <div class="card mb-4">
        {{if .Thread.ImageURL}}
          <img src="{{.Thread.ImageURL}}" alt="{{.Thread.Title}}" class="card-img-top" style="height: 250px; width: 100%; object-fit: contain;">
        {{end}}
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-start gap-3 mb-3">
            <div>
              <h1 class="card-title h3 mb-2">{{.Thread.Title}}</h1>
              <p class="card-text text-body-secondary mb-0"></p>
            </div>
            {{if eq .Thread.OwnerUserID .User.ID}}
              <a href="/forum/{{.Forum.ExternalID}}/thread/{{.Thread.ExternalID}}/edit" class="btn btn-sm btn-outline-secondary" style="width: 32px; height: 32px; min-width: 32px; min-height: 32px; padding: 0; display: flex; align-items: center; justify-content: center;" title="Editar">
                {{template "icon-pencil" .}}
              </a>
            {{end}}
          </div>
          <div class="d-flex flex-column flex-md-row gap-3 small text-body-secondary">
            <span>Criador: <strong>{{.Thread.OwnerUserName}}</strong></span>
            <span>Criado em: <strong>{{.Thread.CreatedAt.Format "2006-01-02 15:04"}}</strong></span>
          </div>
        </div>
      </div>

      <!-- Reply button -->
      {{if .Authed}}
        <div class="mb-4">
          <a href="#reply-form" class="btn btn-primary d-inline-flex align-items-center gap-2">
            {{template "icon-pencil" .}}
            <span>Responder</span>
          </a>
        </div>
      {{end}}

      <!-- Posts list -->
      <section aria-label="Lista de mensagens" class="mb-4">
        <div id="post-list">
          {{template "post_list" .}}
        </div>
      </section>

      <!-- Reply form (only for authenticated users) -->
      {{if .Authed}}
        <section id="reply-form" class="mt-5">
          <div class="card">
            <div class="card-header">
              <h5 class="mb-0">Responder ao Tópico</h5>
            </div>
            <div class="card-body">
              <form 
                  method="POST" 
                  hx-post="/forum/{{.Forum.ExternalID}}/thread/{{.Thread.ExternalID}}/post" 
                  hx-target="#post-list" 
                  hx-swap="beforeend">
                <div class="mb-3">
                  <label for="content" class="form-label">Mensagem</label>
                  <textarea 
                      class="form-control" 
                      id="content" 
                      name="content" 
                      rows="5" 
                      data-provide="md-mini"
                      data-preview-url="/api/markdown/preview"
                      required></textarea>
                </div>
                <button type="submit" class="btn btn-primary">Enviar Resposta</button>
              </form>
            </div>
          </div>
        </section>
      {{else}}
        <div class="alert alert-info text-center mb-0">
          <p class="mb-0"><a href="/login">Faça login</a> para responder aos tópicos.</p>
        </div>
      {{end}}
    </main>

    <!-- Edit post modal -->
    {{template "edit_post_modal" .}}

    <!-- Insert media modals -->
    {{template "insert_image_modal" .}}
    {{template "insert_video_modal" .}}
    {{template "insert_audio_modal" .}}

    <footer>
      {{template "footer" .}}
    </footer>
    {{template "scripts" .}}
    <script defer src="/assets/md-mini.js?v={{ .Config.GitTag }}"></script>
    <script defer src="/assets/md-insert-image.min.js?v={{ .Config.GitTag }}"></script>
    <script defer src="/assets/md-insert-video.min.js?v={{ .Config.GitTag }}"></script>
    <script defer src="/assets/md-insert-audio.min.js?v={{ .Config.GitTag }}"></script>
    <script defer src="/assets/forum-edit-post.min.js?v={{ .Config.GitTag }}"></script>
    <script defer src="/assets/forum-delete-post.min.js?v={{ .Config.GitTag }}"></script>
  </body>
</html>
