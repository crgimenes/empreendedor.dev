<!doctype html>
<html lang="pt-BR" data-bs-theme="dark">
  <head>
    {{template "head" .}}
  </head>

  <body>
    {{template "navbar" .}}

        <main class="container-fluid container-lg py-4 py-lg-5">
      <nav aria-label="breadcrumb">
          <ol class="breadcrumb">
              <li class="breadcrumb-item"><a href="/eav">Workspaces</a></li>
              <li class="breadcrumb-item"><a href="/eav/forms?workspace_id={{.Form.WorkspaceID}}">Formulários</a></li>
              <li class="breadcrumb-item active" aria-current="page">{{.Form.Label}} - Registros</li>
          </ol>
      </nav>

            <div class="d-flex flex-column flex-md-row gap-3 justify-content-between align-items-start align-items-md-center mb-4">
                <div>
                    <h1 class="h3 mb-1">Registros do formulário</h1>
                    <p class="text-muted mb-0">{{.Form.Label}}</p>
                </div>
                <div class="w-100" style="max-width: 240px;">
                    <a href="/eav/records/create?form_id={{.Form.ID}}" class="btn btn-primary w-100">Novo Registro</a>
                </div>
            </div>

            {{if .Records}}
            <div class="row g-3 g-md-4">
                {{range .Records}}
                <div class="col-12 col-md-6">
                    <article class="card h-100 shadow-sm">
                        <div class="card-body d-flex flex-column gap-3">
                            <div class="d-flex justify-content-between align-items-start">
                                <div>
                                    <h2 class="h6 mb-1">Registro #{{.ID}}</h2>
                                    <p class="text-muted small mb-1">Ref: <code>{{.ReferenceID}}</code></p>
                                    <div class="small text-muted">Criado em {{.CreatedAt.Format "02/01/2006 15:04"}}</div>
                                </div>
                                <span class="badge text-bg-dark text-uppercase">{{.Status}}</span>
                            </div>

                            <div class="small text-muted">
                                Atualizado em {{.UpdatedAt.Format "02/01/2006 15:04"}}
                            </div>

                            <div class="mt-auto">
                                <button class="btn btn-outline-secondary w-100" type="button" disabled>
                                    Edição disponível em breve
                                </button>
                            </div>
                        </div>
                    </article>
                </div>
                {{end}}
            </div>
            {{else}}
            <div class="card border-0 bg-body-secondary bg-opacity-25">
                <div class="card-body text-center py-5">
                    <p class="text-muted mb-3">Nenhum registro encontrado.</p>
                    <a href="/eav/records/create?form_id={{.Form.ID}}" class="btn btn-primary">Criar primeiro registro</a>
                </div>
            </div>
            {{end}}
    </main>
    
    <footer>
      {{template "footer" .}}
    </footer>
    {{template "scripts" .}}
  </body>
</html>
