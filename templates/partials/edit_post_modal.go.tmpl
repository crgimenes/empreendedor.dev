{{define "edit_post_modal"}}
<div class="modal fade" id="editPostModal" tabindex="-1" aria-hidden="true" data-post-id="">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Editar Mensagem</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
      </div>
      <div class="modal-body">
        <form id="editPostForm" method="POST">
          <div class="mb-3">
            <label for="editPostContent" class="form-label">Mensagem</label>
            <textarea class="form-control" id="editPostContent" name="content" rows="8" data-provide="md-mini" data-preview-url="/api/markdown/preview" required></textarea>
          </div>
        </form>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
        <button type="button" class="btn btn-primary" id="saveEditPostBtn">Salvar</button>
      </div>
    </div>
  </div>
</div>
{{end}}
