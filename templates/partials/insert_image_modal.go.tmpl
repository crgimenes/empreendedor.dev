{{define "insert_image_modal"}}
<div class="modal fade" id="insertImageModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Inserir Imagem</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
      </div>
      <div class="modal-body">
        <!-- Image list -->
        <div class="mb-4">
          <label class="form-label">Suas Imagens (Mais Recentes Primeiro)</label>
          <div id="imageList" style="max-height: 300px; overflow-y: auto; border: 1px solid var(--bs-border-color); border-radius: 0.375rem; padding: 0.5rem;">
            <div class="text-center text-body-secondary py-4">
              <small>Carregando imagens...</small>
            </div>
          </div>
        </div>

        <!-- Divider -->
        <div class="mb-4">
          <small class="text-body-secondary d-block text-center">ou</small>
        </div>

        <!-- Upload new image -->
        <div class="mb-3">
          <label class="form-label">Fazer Upload de Nova Imagem</label>
          <form id="uploadImageForm" enctype="multipart/form-data" class="needs-validation" novalidate>
            <div class="mb-3">
              <input class="form-control" type="file" id="imageFileInput" name="file" accept="image/*" required>
              <small class="form-text text-body-secondary">Formatos: JPG, PNG, GIF, WebP (máx. 500 MB)</small>
            </div>

            <div class="mb-3">
              <label for="imageDescription" class="form-label">Descrição (opcional)</label>
              <textarea class="form-control" id="imageDescription" name="description" rows="2" placeholder="Descreva a imagem..." maxlength="500"></textarea>
              <small class="form-text text-body-secondary">Máximo 500 caracteres</small>
            </div>

            <div id="uploadImageStatus" class="mb-3"></div>

            <button type="submit" class="btn btn-primary w-100" id="uploadImageBtn">Fazer Upload</button>
          </form>
        </div>

        <!-- Divider -->
        <div class="mb-3">
          <small class="text-body-secondary d-block text-center">ou</small>
        </div>

        <!-- URL fallback -->
        <div class="mb-0">
          <label class="form-label">Inserir URL Direta</label>
          <div class="input-group">
            <input type="url" class="form-control" id="imageUrlInput" placeholder="https://exemplo.com/imagem.jpg">
            <button class="btn btn-outline-secondary" type="button" id="insertUrlImageBtn">Inserir</button>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
{{end}}
