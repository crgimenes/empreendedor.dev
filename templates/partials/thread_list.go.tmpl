{{define "thread_list"}}
{{range .Threads}}
  <div class="col">
    <a href="/forum/{{$.Forum.ExternalID}}/thread/{{.ExternalID}}" class="text-decoration-none text-reset">
      <div class="card h-100 d-flex flex-column" style="cursor: pointer; transition: transform 0.2s, box-shadow 0.2s;" onmouseover="this.style.transform='translateY(-4px)'; this.style.boxShadow='0 4px 12px rgba(0,0,0,0.15)'" onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow=''">
        {{if .ImageURL}}
          <img src="{{.ImageURL}}" alt="{{.Title}}" class="card-img-top" style="height: 200px; width: 100%; object-fit: contain;">
        {{end}}
        <div class="card-body d-flex flex-column">
          <h5 class="card-title mb-2">{{.Title}}</h5>
          <div class="d-flex justify-content-between align-items-center small mb-2 mt-auto">
            <span class="text-body-secondary">Criado em {{.CreatedAt.Format "2006-01-02 15:04"}}</span>
          </div>
          <div class="small text-body-secondary">
            <span>Criador: {{.OwnerUserName}}</span>
          </div>
        </div>
      </div>
    </a>
    {{if eq .OwnerUserID $.User.ID}}
      <div class="mt-2">
        <a href="/forum/{{$.Forum.ExternalID}}/thread/{{.ExternalID}}/edit" class="btn btn-sm btn-outline-secondary w-100">Editar Tópico</a>
      </div>
    {{end}}
  </div>
{{else}}
  <div class="col-12">
    <div class="alert alert-info text-center mb-0">
      <p class="mb-0">Nenhum tópico disponível neste fórum.</p>
    </div>
  </div>
{{end}}
{{end}}
