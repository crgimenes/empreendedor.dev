{{define "file-card"}}
<div class="card h-100 shadow-sm rounded-2 overflow-hidden">
  <!-- Square thumbnail placeholder: contain to avoid cutting image/video -->
  <a href="/files/edit?id={{.Filename}}" class="ratio ratio-1x1 bg-body-secondary d-flex align-items-center justify-content-center text-decoration-none" style="cursor: pointer;">
    {{/* Render thumbnail based on media kind (MIME with extension fallback) */}}
    {{- if eq .MediaKind "image" -}}
      <img src="/file/{{.UserRefID}}/{{urlquery .Filename}}" alt="{{if .OriginalFilename}}{{.OriginalFilename}}{{else}}{{.Filename}}{{end}}" class="w-100 h-100 object-fit-contain" loading="lazy">
    {{- else if eq .MediaKind "video" -}}
      <video src="/file/{{.UserRefID}}/{{urlquery .Filename}}" class="w-100 h-100 object-fit-contain" preload="metadata" autoplay playsinline webkit-playsinline muted loop data-autoplay-visible="true" data-generate-poster="true">
        Seu navegador não suporta a reprodução de vídeo.
      </video>
    {{- else if eq .MediaKind "audio" -}}
      {{template "icon-audio" .}}
    {{- else -}}
      {{template "icon-file" .}}
    {{- end }}
  </a>

  <div class="card-body d-flex flex-column">
    <!-- File name -->
    <h3 class="h6 card-title mb-1 text-truncate" title="{{if .OriginalFilename}}{{.OriginalFilename}}{{else}}{{.Filename}}{{end}}">
      {{if .OriginalFilename}}{{.OriginalFilename}}{{else}}{{.Filename}}{{end}}
    </h3>

    <!-- Meta: size and date -->
    <div class="small text-body-secondary mb-2">{{.Filesize}} bytes • {{.CreatedAt}}</div>

    <!-- Short description -->
    <p class="card-text small {{if .Filedescription}}text-body{{else}}text-body-secondary fst-italic{{end}} text-truncate" style="max-height: 3rem;">
      {{if .Filedescription}}{{.Filedescription}}{{else}}sem descrição{{end}}
    </p>

    <!-- Tags / Categories -->
    {{if .Filetag}}
    <div class="mb-3 d-flex flex-wrap gap-1">
      {{/* Render each CSV tag as a separate badge */}}
      {{range $i, $t := split .Filetag ","}}
        {{- $clean := trim $t -}}
        {{- if $clean -}}
        <span class="badge text-bg-secondary">{{$clean}}</span>
        {{- end -}}
      {{end}}
    </div>
    {{end}}

    <!-- Actions (icon-only buttons) -->
    <div class="mt-auto d-flex gap-2">
      <a href="/files/edit?id={{.Filename}}" class="btn btn-sm btn-outline-secondary d-inline-flex align-items-center justify-content-center" title="Editar" aria-label="Editar">
        {{template "icon-pencil" .}}
        <span class="visually-hidden">Editar</span>
      </a>
    </div>
  </div>
</div>
{{end}}

