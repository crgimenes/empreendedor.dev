<!doctype html>
<html lang="pt-BR" data-bs-theme="dark">
<head>
    {{template "head" .}}
</head>

<body>
    <p>Selecione abaixo como deseja entrar no sistema.</p>
    {{if .Config.GithubOAuthEnabled}}
        <a href="/login/github" rel="nofollow">Entrar com GitHub</a>
        <br>
    {{end}}
    {{if .Config.XOAuthEnabled}}
        <a href="/login/x" rel="nofollow">Entrar com X (Twitter)</a>
        <br>
    {{end}}
    {{if .Config.FakeOAuthEnabled}}
        <a href="/login/fake" rel="nofollow">Login Fake OAuth</a>
        <br>
    {{end}}

    <form method="post" action="/login/magic_link">
        <h2>Login por e-mail</h2>
        <p>Envie-me um link de login</p>
        <label for="email">e-mail:</label>
        <input type="email" id="email" name="email" required>
        <br>
        <button type="submit">Entrar</button>
    </form>

    <a href="/login/create_new_account" rel="nofollow">Criar nova conta</a>
    <br>
    <a href="/" rel="nofollow">Voltar</a>
    <br>
    Ao prosseguir, você concorda com o uso de cookies de sessão.
    <footer>
        {{template "footer" .}}
    </footer>
    {{template "scripts" .}}
</body>

</html>
