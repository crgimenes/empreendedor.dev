<!doctype html>
<html lang="pt-BR" data-bs-theme="dark">
  <head>
    {{template "head" .}}
  </head>

  <body>
    {{template "navbar" .}}

    <main class="container py-5">
      <div class="row">
        <div class="col-lg-8 mx-auto">
          {{if .Message}}
            <div class="alert alert-info alert-dismissible fade show mb-4" role="alert">
              {{.Message}}
              <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
          {{end}}
          
          <div class="card">
            <div class="card-body text-center">
                <h1 class="card-title mb-4">Bem-vindo ao {{ .Config.SiteTitle }}</h1>
              <p class="card-text mb-4">Conecte-se com sua conta para continuar.</p>
              <a href="/login" class="btn btn-primary btn-lg">Ir para Login</a>
            </div>
          </div>
        </div>
      </div>
    </main>
    
    <footer>
      {{template "footer" .}}
    </footer>
    {{template "scripts" .}}
  </body>
</html>

