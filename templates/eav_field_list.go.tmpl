<!doctype html>
<html lang="pt-BR" data-bs-theme="dark">
  <head>
    {{template "head" .}}
  </head>

  <body>
    {{template "navbar" .}}

        <main class="container-fluid container-lg py-4 py-lg-5">
      <nav aria-label="breadcrumb">
          <ol class="breadcrumb">
              <li class="breadcrumb-item"><a href="/eav">Workspaces</a></li>
              <li class="breadcrumb-item"><a href="/eav/forms?workspace_id={{.Form.WorkspaceID}}">Formulários</a></li>
              <li class="breadcrumb-item active" aria-current="page">{{.Form.Label}} - Campos</li>
          </ol>
      </nav>

            <div class="d-flex flex-column flex-md-row gap-3 justify-content-between align-items-start align-items-md-center mb-4">
                <div>
                    <h1 class="h3 mb-1">Campos do formulário</h1>
                    <p class="text-muted mb-0">{{.Form.Label}}</p>
                </div>
                <div class="w-100" style="max-width: 240px;">
                    <a href="/eav/fields/create?form_id={{.Form.ID}}" class="btn btn-primary w-100">Novo Campo</a>
                </div>
            </div>

            {{if .Fields}}
            <div class="row g-3 g-md-4">
                {{range .Fields}}
                <div class="col-12 col-md-6">
                    <article class="card h-100 shadow-sm">
                        <div class="card-body d-flex flex-column gap-3">
                            <div class="d-flex justify-content-between align-items-start gap-2">
                                <div>
                                    <h2 class="h6 mb-1">{{.Label}}</h2>
                                    <p class="text-muted small mb-1">Machine name: <code>{{.MachineName}}</code></p>
                                    <div class="small text-muted">Ordem: {{.ZOrder}}</div>
                                </div>
                                <div class="d-flex flex-column gap-1 align-items-end">
                                    <span class="badge text-bg-dark">{{.PrimitiveKind}}</span>
                                    <span class="badge {{if .IsUI}}text-bg-info{{else}}text-bg-secondary{{end}}">{{if .IsUI}}Somente UI{{else}}Dado{{end}}</span>
                                    {{if .IsReadonly}}
                                    <span class="badge text-bg-warning text-dark">Somente leitura</span>
                                    {{end}}
                                </div>
                            </div>

                            <div class="row g-2 small text-muted">
                                <div class="col-6">
                                    <div class="fw-semibold">UI Kind</div>
                                    <div>{{if .UIKind}}{{.UIKind}}{{else}}—{{end}}</div>
                                </div>
                                <div class="col-6 text-md-end">
                                    <div class="fw-semibold">Obrigatório</div>
                                    <div>{{if .Required}}Sim{{else}}Não{{end}}</div>
                                </div>
                            </div>

                            <div class="mt-auto">
                                <a href="/eav/fields/edit?id={{.ID}}" class="btn btn-outline-light w-100">Editar campo</a>
                            </div>
                        </div>
                    </article>
                </div>
                {{end}}
            </div>
            {{else}}
            <div class="card border-0 bg-body-secondary bg-opacity-25">
                <div class="card-body text-center py-5">
                    <p class="text-muted mb-3">Nenhum campo cadastrado para este formulário.</p>
                    <a href="/eav/fields/create?form_id={{.Form.ID}}" class="btn btn-primary">Cadastrar primeiro campo</a>
                </div>
            </div>
            {{end}}
    </main>
    
    <footer>
      {{template "footer" .}}
    </footer>
    {{template "scripts" .}}
  </body>
</html>
