<!doctype html>
<html lang="pt-BR" data-bs-theme="dark">
  <head>
    {{template "head" .}}
  </head>

  <body>
    {{template "navbar" .}}

    <main class="container py-5">
      <div class="row">
        <div class="col-lg-8 mx-auto">
          {{if .Message}}
            <div class="alert alert-info alert-dismissible fade show mb-4" role="alert">
              {{.Message}}
              <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
          {{end}}

            <!-- Dashboard Card -->
            <div class="mb-4">
                <p>Teste Dashboard</p>
            </div>

          <div class="card">
            <div class="card-body">
              <h1 class="card-title">Bem-vindo, {{.User.Username}}!</h1>
              <p class="card-text text-muted">Email: {{.User.Email}}</p>
              {{if .User.AvatarURL}}
                <img src="{{.User.AvatarURL}}" alt="Avatar" class="img-thumbnail mb-3" style="max-width: 150px;">
              {{end}}
              <p class="mb-3">
                {{if .User.Enabled}}
                  <span class="badge bg-success">Conta Ativa</span>
                {{else}}
                  <span class="badge bg-warning">Conta Incompleta</span>
                {{end}}
              </p>
              <a href="/me" class="btn btn-primary">Editar Perfil</a>
            </div>
          </div>
        </div>
      </div>
    </main>
    
    <footer>
      {{template "footer" .}}
    </footer>
    {{template "scripts" .}}
  </body>
</html>

