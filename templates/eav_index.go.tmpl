<!doctype html>
<html lang="pt-BR" data-bs-theme="dark">
  <head>
    {{template "head" .}}
  </head>

  <body>
    {{template "navbar" .}}

    <main class="container-fluid container-lg py-4 py-lg-5">
      <div class="d-flex flex-column flex-md-row gap-3 justify-content-between align-items-start align-items-md-center mb-4">
        <div>
          <h1 class="h3 mb-1">Workspaces do EAV</h1>
          <p class="text-muted mb-0">Organize formulários e registros por área ou produto.</p>
        </div>
        <div class="w-100" style="max-width: 240px;">
          <a href="/eav/workspaces/create" class="btn btn-primary w-100">
            Novo Workspace
          </a>
        </div>
      </div>

      {{if .Workspaces}}
      <div class="row g-3 g-md-4">
        {{range .Workspaces}}
        <div class="col-12 col-md-6 col-xl-4">
          <article class="card h-100 shadow-sm">
            <div class="card-body d-flex flex-column gap-3">
              <div class="d-flex flex-column gap-1">
                <div class="d-flex justify-content-between align-items-start">
                  <div>
                    <h2 class="h5 mb-1">{{.Name}}</h2>
                    <p class="text-muted small mb-0">{{if .Description}}{{.Description}}{{else}}Sem descrição cadastrada{{end}}</p>
                  </div>
                  <span class="badge text-bg-secondary">#{{.ID}}</span>
                </div>
                <div class="small text-muted">
                  <div>Ref: <code>{{.ReferenceID}}</code></div>
                  <div>Criado em {{.CreatedAt.Format "02/01/2006 15:04"}}</div>
                </div>
              </div>

              <div class="d-flex flex-column flex-sm-row gap-2">
                <a href="/eav/forms?workspace_id={{.ID}}" class="btn btn-outline-light flex-fill">
                  Formulários
                </a>
                <a href="/eav/workspaces/edit?id={{.ID}}" class="btn btn-outline-secondary flex-fill">
                  Editar
                </a>
              </div>
            </div>
          </article>
        </div>
        {{end}}
      </div>
      {{else}}
      <div class="card border-0 bg-body-secondary bg-opacity-25">
        <div class="card-body text-center py-5">
          <p class="text-muted mb-3">Nenhum workspace encontrado.</p>
          <a href="/eav/workspaces/create" class="btn btn-primary">Criar primeiro workspace</a>
        </div>
      </div>
      {{end}}
    </main>
    
    <footer>
      {{template "footer" .}}
    </footer>
    {{template "scripts" .}}
  </body>
</html>
