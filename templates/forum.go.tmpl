<!doctype html>
<html lang="pt-BR" data-bs-theme="dark">
  <head>
    {{template "head" .}}
  </head>

  <body>
    {{template "forum_navbar" .}}

    <main class="container py-4 py-md-5">
      <!-- Header: title and primary actions -->
      <div class="d-flex flex-column flex-md-row align-items-start align-items-md-center justify-content-between gap-3 mb-4">
        <div>
          <h1 class="h3 mb-0">Fóruns</h1>
          <small class="text-body-secondary">Participe de discussões e compartilhe conhecimento</small>
        </div>
        {{if .Authed}}
          <div class="ms-md-auto d-flex flex-column align-items-start align-items-md-end gap-2">
            <a href="/forum/create" class="btn btn-primary d-inline-flex align-items-center gap-2">
              {{template "icon-plus" .}}
              <span>Novo Fórum</span>
            </a>
          </div>
        {{end}}
      </div>

      <!-- Forums list -->
      <section aria-label="Lista de fóruns">
        <div id="forum-list" class="row row-cols-1 row-cols-md-2 g-3">
          {{template "forum_list" .}}
        </div>
      </section>

      <!-- Pagination sentinel for infinite scroll -->
      {{if .HasMore}}
        <div id="pagination-sentinel"
             hx-get="/forum/list"
             hx-trigger="revealed"
             hx-target="#forum-list"
             hx-swap="beforeend"
             hx-include="[data-pagination]"
             data-pagination="true"
             data-offset="{{.NextOffset}}"
             data-limit="{{.Limit}}">
        </div>
      {{end}}
    </main>

    <footer>
      {{template "footer" .}}
    </footer>
    {{template "scripts" .}}
    <!-- Page specific scripts -->
    <script defer src="/assets/htmx.min.js?v={{ .Config.GitTag }}"></script>
  </body>
</html>
