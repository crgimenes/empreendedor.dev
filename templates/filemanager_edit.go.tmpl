{{define "filemanager_edit.go.tmpl"}}
<!doctype html>
<html lang="pt-BR" data-bs-theme="dark">
<head>
    {{template "head" .}}
</head>

<body>
    {{template "filemanager_navbar" .}}

    <main class="container py-5">
        <div class="row justify-content-center">
            <div class="col-md-8">
                <div class="card">
                    <div class="card-body">
                        <h1 class="card-title mb-4 h4 text-break">{{.File.OriginalFilename}}</h1>

                        {{if .Error}}
                            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                                {{.Error}}
                                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                            </div>
                        {{end}}

                        <form method="POST" class="needs-validation">
                            <input type="hidden" name="csrf_token" value="{{.Csrf}}">
                            <input type="hidden" name="file_id" value="{{.File.Filename}}">

                            <!-- File preview -->
                            <div class="mb-4">
                                {{/* Preferir metadados do servidor para decidir como prever */}}
                                {{- if eq .MediaKind "audio" -}}
                                    {{/* Para audio: apenas a barra de controle, sem caixa quadrada */}}
                                    <audio src="/file/{{.User.ReferenceID}}/{{urlquery .File.Filename}}" class="w-100" controls preload="metadata">
                                        Seu navegador não suporta a reprodução de áudio.
                                    </audio>
                                {{- else -}}
                                    <div class="ratio ratio-1x1 bg-body-secondary d-flex align-items-center justify-content-center rounded overflow-hidden">
                                        {{- if eq .MediaKind "image" -}}
                                            <img src="/file/{{.User.ReferenceID}}/{{urlquery .File.Filename}}" alt="{{.File.OriginalFilename}}" class="w-100 h-100 object-fit-contain">
                                        {{- else if eq .MediaKind "video" -}}
                                            <video id="file-preview-video" src="/file/{{.User.ReferenceID}}/{{urlquery .File.Filename}}" class="w-100 h-100 object-fit-contain" preload="auto" controls playsinline muted>
                                                Seu navegador não suporta a reprodução de vídeo.
                                            </video>
                                        {{- else -}}
                                            {{template "icon-file" .}}
                                        {{- end }}
                                    </div>
                                {{- end }}
                                <p class="text-muted small mt-3 mb-0"><strong>Arquivo:</strong> {{.File.OriginalFilename}}</p>
                                <p class="text-muted small"><strong>Tipo:</strong> {{.File.Filetype}}</p>
                                <p class="text-muted small"><strong>Tamanho:</strong> {{.File.Filesize}} bytes</p>
                            </div>

                            <!-- Description -->
                            <div class="mb-3">
                                <label for="description" class="form-label">Descrição</label>
                                <textarea class="form-control" id="description" name="description" rows="3" placeholder="Descreva o arquivo ou adicione notas sobre seu conteúdo" maxlength="500">{{.File.Filedescription}}</textarea>
                                <small class="form-text text-body-secondary">Máximo 500 caracteres</small>
                            </div>

                                                        <!-- Categorias (tags) -->
                                                        <div class="mb-4">
                                                                <label for="tagInput" class="form-label">Categorias</label>
                                                                <input id="tagInput" type="text" name="filetag" class="form-control" value="{{.File.Filetag}}" placeholder="Digite e pressione Enter" autocomplete="off" data-ub-tag-separator="," data-ub-tag-max="20">
                                                                <div class="form-text" id="tagHelp">Pressione Enter, vírgula ou Tab para criar uma tag. Acentos são permitidos; vírgula não é permitida dentro de uma tag.</div>
                                                                <div class="invalid-feedback">Tags inválidas. Use letras (com acentos), números, espaço e . _ - /. Máx. 32 caracteres por tag, 20 tags, 512 no total.</div>
                                                        </div>

                            <!-- Buttons -->
                            <div class="d-grid gap-2 d-md-flex justify-content-md-end gap-2">
                                <a href="/files" class="btn btn-secondary">Cancelar</a>
                                <button type="submit" class="btn btn-primary">Salvar Alterações</button>
                            </div>
                        </form>
                    </div>
                </div>
                <!-- Danger zone: delete file -->
                <div class="card mt-3">
                    <div class="card-body">
                        <h2 class="h6 card-title mb-3">Excluir arquivo</h2>
                        <p class="mb-3">Tem certeza que deseja excluir este arquivo?</p>
                        <form method="POST" action="/files/delete">
                            <input type="hidden" name="csrf_token" value="{{.Csrf}}">
                            <input type="hidden" name="file_id" value="{{.File.Filename}}">
                            <button type="submit" class="btn btn-outline-danger d-inline-flex align-items-center gap-2">
                                {{template "icon-trash" .}}
                                <span>Excluir arquivo</span>
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <footer>
        {{template "footer" .}}
    </footer>
    {{template "scripts" .}}
    <link rel="stylesheet" href="/assets/use-bootstrap-tag.min.css?v={{.Config.GitTag}}">
    <script src="/assets/use-bootstrap-tag.min.js?v={{.Config.GitTag}}" defer></script>
    <script src="/assets/filemanager-edit.min.js?v={{.Config.GitTag}}" defer></script>
</body>
</html>
{{end}}

