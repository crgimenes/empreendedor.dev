{{define "hello.go.tmpl"}}
<!doctype html>
<html lang="pt-BR" data-bs-theme="dark">
  <head>
    {{template "head" .}}
    <title>Olá Mundo - {{.Config.SiteTitle}}</title>
  </head>

  <body>
    {{template "navbar" .}}

    <main class="container py-5">
      <div class="row justify-content-center">
        <div class="col-lg-6">
          <div class="card">
            <div class="card-header">
              <h4 class="mb-0"><i class="bi bi-person"></i> Olá Mundo</h4>
            </div>
            <div class="card-body text-center">
              {{if .Authed}}
                <h1 class="display-4 mb-4">Olá, {{.User.Username}}!</h1>
                <p class="lead text-muted">
                  Você está logado como <strong>{{.User.Email}}</strong>
                </p>
                {{if .User.Sysop}}
                  <span class="badge bg-primary">Sysop</span>
                {{end}}
              {{else}}
                <h1 class="display-4 mb-4">Olá, Visitante!</h1>
                <p class="lead text-muted">
                  Você não está logado.
                </p>
                <a href="/login" class="btn btn-primary">Fazer Login</a>
              {{end}}
            </div>
          </div>
        </div>
      </div>
    </main>

    <footer>
      {{template "footer" .}}
    </footer>
    {{template "scripts" .}}
  </body>
</html>
{{end}}
