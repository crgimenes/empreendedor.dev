<!doctype html>
<html lang="pt-BR" data-bs-theme="dark">
<head>
    {{template "head" .}}
    <link rel="stylesheet" href="/assets/use-bootstrap-tag.min.css?v={{.Config.GitTag}}">
    <title>Enviar Arquivo</title>
    
    
</head>

<body>
    {{template "filemanager_navbar" .}}

    <main class="container py-5">
        <div class="row justify-content-center">
            <div class="col-md-8">
                <div class="card">
                    <div class="card-body">
                        <h1 class="card-title mb-4">Enviar Arquivo</h1>

                        {{if .Error}}
                            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                                {{.Error}}
                                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                            </div>
                        {{end}}

                        {{if .Message}}
                            <div class="alert alert-success alert-dismissible fade show" role="alert">
                                {{.Message}}
                                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                            </div>
                        {{end}}

                        <form method="POST" action="/files/upload" class="needs-validation" enctype="multipart/form-data" novalidate>
                            <input type="hidden" name="csrf_token" value="{{.Csrf}}">

                            <!-- File Upload -->
                            <div class="mb-4">
                                <label for="file" class="form-label">Arquivo</label>
                                <input class="form-control form-control-lg" type="file" id="file" name="file" accept="image/*,video/*,audio/*" required>
                                <small class="form-text text-body-secondary">Tipos aceitos: imagens (JPG, PNG, GIF, WebP), vídeos (MP4, WebM, Ogg), áudio (MP3, WAV, OGG)</small>
                            </div>

                            <input type="hidden" id="original_filename" name="original_filename">

                            <!-- File Description -->
                            <div class="mb-4">
                                <label for="description" class="form-label">Descrição</label>
                                <textarea class="form-control" id="description" name="description" rows="3" placeholder="Descreva o arquivo ou adicione notas sobre seu conteúdo" maxlength="500"></textarea>
                                <small class="form-text text-body-secondary">Máximo 500 caracteres</small>
                            </div>

                            <!-- Categorias (tags) -->
                            <div class="mb-4">
                                <label for="tagInput" class="form-label">Categorias</label>
                                <input id="tagInput" type="text" name="filetag" class="form-control" value="" placeholder="Digite e pressione Enter" autocomplete="off" data-ub-tag-separator="," data-ub-tag-max="20">
                                <div class="form-text" id="tagHelp">Pressione Enter, vírgula ou Tab para criar uma tag. Acentos são permitidos; vírgula não é permitida dentro de uma tag.</div>
                                <div class="invalid-feedback">Tags inválidas. Use letras (com acentos), números, espaço e . _ - /. Máx. 32 caracteres por tag, 20 tags, 512 no total.</div>
                            </div>

                            <!-- Buttons -->
                            <div class="d-grid gap-2 d-md-flex justify-content-md-end gap-2">
                                <a href="/files" class="btn btn-secondary">Cancelar</a>
                                <button type="submit" class="btn btn-primary">Enviar Arquivo</button>
                            </div>
                        </form>

                        <hr class="my-4">

                        <!-- File Type Reference -->
                        <div class="card bg-body-secondary border-0">
                            <div class="card-body">
                                <h6 class="card-title mb-3">Tipos de Arquivo Suportados</h6>
                                <div class="row g-3">
                                    <div class="col-md-6">
                                        <strong class="text-body-secondary">Imagens:</strong>
                                        <small class="d-block text-body-secondary">JPEG, PNG, GIF, WebP</small>
                                    </div>
                                    <div class="col-md-6">
                                        <strong class="text-body-secondary">Vídeos:</strong>
                                        <small class="d-block text-body-secondary">MP4, WebM, Ogg</small>
                                    </div>
                                    <div class="col-md-6">
                                        <strong class="text-body-secondary">Áudio:</strong>
                                        <small class="d-block text-body-secondary">MP3, WAV, OGG, M4A</small>
                                    </div>
                                    <div class="col-md-6">
                                        <strong class="text-body-secondary">Limite:</strong>
                                        <small class="d-block text-body-secondary">Máximo 500 MB por arquivo</small>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </main>

    <footer>
        {{template "footer" .}}
    </footer>
    {{template "scripts" .}}
    <script src="/assets/use-bootstrap-tag.min.js?v={{.Config.GitTag}}" defer></script>
    <script src="/assets/filemanager-upload.min.js?v={{.Config.GitTag}}" defer></script>
</body>
</html>
